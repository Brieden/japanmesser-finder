{
  "name": "japanmesser-finder",
  "version": "1.0.0",
  "private": true,
  "description": "Auswahlhilfe für japanische Küchenmesser (statische Webseite für GitHub Pages)",
  "type": "module",
  "scripts": {
    "test": "node --test tests/",
    "serve": "python3 -m http.server 8077",
    "fetch:catalog": "node scripts/fetch-catalog.mjs data/raw",
    "fetch:specs": "node scripts/fetch-product-specs.mjs data/raw/products.json data/raw/specs.jsonl",
    "build:data": "node scripts/build-data.mjs data/raw/products.json --specs=data/raw/specs.jsonl"
  },
  "engines": { "node": ">=20" }
}
